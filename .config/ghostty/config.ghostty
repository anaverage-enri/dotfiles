window-save-state = always
quit-after-last-window-closed = true


# Window Customization
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.85
background-blur = 25
window-decoration = true

# Interaction
copy-on-select = true
scrollback-limit = 50000
mouse-scroll-multiplier = 2
mouse-hide-while-typing = true
